# Copia este archivo a .env.local para desarrollo. En Vercel, pega cada valor
# en Settings > Environment Variables (nunca en el chat ni en el repositorio).

# Cadena de conexión del rol "setter_app" (Supabase > Connect > Session/Transaction pooler).
SETTER_DATABASE_URL=

# Clave de la API de Claude (console.anthropic.com).
ANTHROPIC_API_KEY=
# Opcional: modelo para leer los formularios.
ANALYSIS_MODEL=claude-opus-5-5
# Opcional: tope de análisis por día (protege el gasto).
MAX_ANALISIS_DIA=200

# Bot de Telegram (BotFather) y tu chat privado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Enlace del regalo (PDF) que se muestra al terminar el formulario.
GIFT_URL=
# Opcional: enlace a la política de privacidad.
PRIVACY_URL=

# Secreto del webhook de Telegram (inventa uno de letras, números, - y _; 30+ caracteres).
TELEGRAM_WEBHOOK_SECRET=
